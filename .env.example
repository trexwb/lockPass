# ═══════════════════════════════════════════════════════════════════
# LockPass 更新签名环境变量（示例文件）
# ───────────────────────────────────────────────────────────────────
# 使用方法：复制本文件为 .env.local，填入真实值后使用。
#   cp .env.example .env.local
#
# 加载方式（v1.0.14 起）：npm run tauri:build 时由包装器
# scripts/with-updater-key.mjs 自动读取 .env.local，无需手动 source。
# 手动使用：source .env.local 后再执行构建命令。
# ═══════════════════════════════════════════════════════════════════

# 生成签名密钥：
# npm run tauri -- signer generate -p <密码> -w ~/.tauri/lockpass-updater.key

# 私钥文件路径（指针形式，避免在文件里复制私钥内容）
export TAURI_SIGNING_PRIVATE_KEY_PATH="$HOME/.tauri/lockpass-updater.key"

# ⚠️ 当前密钥为「带密码加密」状态（rsign encrypted secret key）
# 把下面占位符替换成你生成密钥时设置的密码；留空串会报 Wrong password
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=your_password_here

# 方式二（备用）：内联私钥内容——仅当第三方 CI 不支持 PATH 形式时启用：
# 1) 注释掉上面的 PATH 行  2) 取消下行注释并粘贴 ~/.tauri/lockpass-updater.key 全文
# export TAURI_SIGNING_PRIVATE_KEY="
# （密钥文件全文，含首行 untrusted comment）
# "
