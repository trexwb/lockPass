<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 局域网同步（docs/multi-device-sync-design.md §7.4）：
     macOS 的「本地网络」隐私（Apple TN2420）会直接拒绝未声明用途的 app 访问同网段设备，
     Rust 侧 TcpStream::connect 返回 EPERM「Operation not permitted」；
     而 nc / curl 从终端发起不受此限制 —— 症状即「端口能通、应用连不上」。
     缺这个键就不会出现授权弹窗，同步服务永远连不上。 -->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>LockPass 需要在局域网内直连另一台设备进行密码库同步，数据不经任何服务器。</string>
</dict>
</plist>
